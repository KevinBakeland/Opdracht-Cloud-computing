    {
        "id": "save_stock_new",
        "type": "function",
        "z": "278655a61abfb39e",
        "name": "Save Stock Data",
        "func": "let stocks = flow.get(\"stocks\") || {};\n\nstocks[msg.payload.symbol] = Number(msg.payload.price);\n\nflow.set(\"stocks\", stocks);\n\nreturn msg;",
        "outputs": 1,
        "x": 470,
        "y": 280,
        "wires": [
            [
                "influx_format_new",
                "debug_stock_new"
            ]
        ]
    },
    {
        "id": "influx_format_new",
        "type": "function",
        "z": "278655a61abfb39e",
        "name": "Convert to Influx Format",
        "func": "msg.payload = `price,symbol=${msg.payload.symbol} value=${Number(msg.payload.price)}`;\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 240,
