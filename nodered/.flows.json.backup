    {
        "id": "save_logic",
        "type": "function",
        "z": "2e724a0da2cfa18d",
        "g": "portfolio_api_group",
        "name": "Save to Global",
        "func": "let portfolio = global.get('portfolio') || {};\nlet stock = msg.payload.stock;\n\nif (stock) {\n    portfolio[stock] = {\n        amount: parseFloat(msg.payload.amount) || 0,\n        totalCost: parseFloat(msg.payload.totalCost) || 0\n    };\n    global.set('portfolio', portfolio);\n}\n\nmsg.payload = portfolio;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 650,
        "wires": [
