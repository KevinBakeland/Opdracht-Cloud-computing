    {
        "id": "stock_gen",
        "type": "function",
        "z": "2e724a0da2cfa18d",
        "g": "market_sim_group",
        "name": "Stock Price Generator",
        "func": "let aapl = flow.get('aapl_price') || 150.00;\nlet tsla = flow.get('tsla_price') || 200.00;\nlet kevb = flow.get('kevb_price') || 50.00;  // Nieuw\nlet cats = flow.get('cats_price') || 75.00;  // Nieuw\n\n// Simulatie (-2% tot +2%)\naapl *= (1 + (Math.random() * 0.04 - 0.02));\ntsla *= (1 + (Math.random() * 0.04 - 0.02));\nkevb *= (1 + (Math.random() * 0.04 - 0.02));\ncats *= (1 + (Math.random() * 0.04 - 0.02));\n\nflow.set('aapl_price', aapl);\nflow.set('tsla_price', tsla);\nflow.set('kevb_price', kevb);\nflow.set('cats_price', cats);\n\nnode.send({ payload: aapl.toFixed(2), topic: \"market/AAPL\" });\nnode.send({ payload: tsla.toFixed(2), topic: \"market/TSLA\" });\nnode.send({ payload: kevb.toFixed(2), topic: \"market/KEVB\" });\nnode.send({ payload: cats.toFixed(2), topic: \"market/CATS\" });\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 140,
        "wires": [
            [
                "mqtt_out",
                "911daae624dc2f84"
            ]
        ]
    },
    {
        "id": "mqtt_out",
        "type": "mqtt out",
        "z": "2e724a0da2cfa18d",
        "g": "market_sim_group",
        "name": "Mosquitto Broker",
        "topic": "",
        "qos": "",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mosquitto_broker",
        "x": 790,
        "y": 140,
        "wires": []
    },
    {
        "id": "mqtt_in",
        "type": "mqtt in",
        "z": "2e724a0da2cfa18d",
        "g": "processor_group",
        "name": "Subscribe Market",
        "topic": "market/#",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "mosquitto_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 300,
        "y": 300,
        "wires": [
            [
                "logic_node"
            ]
        ]
    },
    {
        "id": "logic_node",
        "type": "function",
        "z": "2e724a0da2cfa18d",
        "g": "processor_group",
        "name": "Validatie & P/L Berekening",
        "func": "let price = parseFloat(msg.payload);\nlet stockName = msg.topic.split('/')[1];\n\nlet investment = 1000.00;\nlet buyPrice = 100.00; // Standaard\n\n// Specifieke inkoopprijzen instellen\nif (stockName === 'AAPL') buyPrice = 150.00;\nelse if (stockName === 'TSLA') buyPrice = 200.00;\nelse if (stockName === 'KEVB') buyPrice = 50.00;\nelse if (stockName === 'CATS') buyPrice = 75.00;\n\nif (isNaN(price) || price <= 0 || !stockName) return null;\n\nlet profitLoss = ((price - buyPrice) / buyPrice) * investment;\n\nmsg.payload = [{ price: price, profit_loss: profitLoss }, { stock: stockName }];\nmsg.measurement = \"stock_data\";\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 300,
        "wires": [
            [
                "influx_out",
                "673ccc7121a7ae20"
            ]
        ]
    },
    {
        "id": "influx_out",
        "type": "influxdb out",
        "z": "2e724a0da2cfa18d",
        "g": "processor_group",
        "influxdb": "influx_config",
        "name": "Sensors DB",
        "measurement": "",
        "precision": "",
        "retentionPolicy": "",
        "database": "database",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "na",
        "bucket": "na",
        "x": 800,
        "y": 300,
        "wires": []
    },
